# n8n / Resumae environment — TEMPLATE ONLY (no real values committed).
# On restore: copy to `.env`, fill every value from your secret store,
# then `docker compose up -d`.

# --- Postgres (n8n job-queue DB) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# --- LLM (scoring / enrichment via OpenRouter) ---
OPENROUTER_KEY=
OPENROUTER_MODEL=

# --- Telegram notifications ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Job-board / enrichment API keys (radar is paused; optional) ---
HUNTER_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JOOBLE_KEY=
FINDWORK_KEY=
RAPIDAPI_KEY=
SERPAPI_KEY=
APIFY_TOKEN=
THEIRSTACK_KEY=
WAAH_WEBHOOK_URL=

# --- Feature flags ---
AGGREGATORS_ON=
PAID_AGGREGATORS_ON=
RSS_ON=
N8N_BLOCK_ENV_ACCESS_IN_NODE=

# --- n8n public API key (used by the Error-Format node's exec fetch) ---
N8N_API_KEY=
